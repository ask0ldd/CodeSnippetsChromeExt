{
  "manifest_version": 3,
  "name": "Ollama Ext",
  "version": "1.0",
  "description": "Call Ollama API",
  "content_scripts": [
    {
      "matches": ["https://www.dealabs.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "permissions": ["activeTab", "tabs"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "host_permissions": ["http://localhost:11434/*"]
}
